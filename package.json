{
  "name": "agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrate parallel AI coding agents across any runtime, any repo, any issue tracker",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @composio/ao-web dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter '!@composio/ao-web' test",
    "test:integration": "pnpm --filter @composio/ao-integration-tests test:integration",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter '!@composio/ao-web' build && changeset publish",
    "prepare": "husky",
    "postinstall": "node scripts/rebuild-node-pty.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.55.0"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils@<4.0.33": "4.0.33",
      "@babel/core@<7.29.6": "7.29.6",
      "@humanfs/node@<0.16.8": "0.16.8",
      "ajv@<6.14.0": "6.14.0",
      "axios@<1.18.0": "1.18.0",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "browserslist@<4.28.7": "4.28.7",
      "esbuild@<0.28.1": "0.28.1",
      "flatted@<=3.4.1": "3.4.2",
      "follow-redirects@<=1.15.11": "1.16.0",
      "form-data@<4.0.6": "4.0.6",
      "ip-address@<10.3.1": "10.3.1",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "langsmith@<0.6.0": "0.6.0",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.23": "8.5.23",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "sharp@<0.35.4": "0.35.4",
      "shell-quote@<1.9.0": "1.9.0",
      "tar@<7.5.21": "7.5.21",
      "tmp@<0.2.7": "0.2.7",
      "uuid@<11.1.1": "11.1.1",
      "uuid@>=13.0.0 <13.0.1": "13.0.1",
      "vite@>=7.0.0 <7.3.5": "7.3.5"
    }
  }
}
